#!/bin/bash

# omarchy:summary=Returns true if a battery is present on the system.

# Not BAT*: Apple Silicon calls its battery macsmc-battery, so that glob matched nothing on a Mac and
# every Mac looked like a desktop. The type file is what actually identifies a battery.

POWER_SUPPLY_PATH="${OMARCHY_POWER_SUPPLY_PATH:-/sys/class/power_supply}"

for supply in "$POWER_SUPPLY_PATH"/*; do
  [[ -r $supply/type ]] || continue
  [[ $(<"$supply/type") == "Battery" ]] || continue

  # Not every driver exposes `present`. Where it exists it has to say so; where it does not, a device
  # that reports itself as a Battery is one.
  if [[ -r $supply/present ]]; then
    [[ $(<"$supply/present") == "1" ]] || continue
  fi

  exit 0
done

exit 1
