#!/bin/bash

# omarchy:summary=Update everything dnf cannot reach: the Flatpak apps
# omarchy:requires-sudo=true

# On Arch, `yay -Sua` sweeps up everything outside the distro's repositories. This is the Fedora
# equivalent: the things a plain `dnf upgrade` can never move. Flatpak apps (Typora, LocalSend,
# Obsidian, Moonlight from Flathub), and the first-party tools that ship no Fedora/COPR aarch64
# package and come from upstream release binaries or source builds (aether, cliamp, omacut, omawrite,
# tensaku, voxtype, tobi-try, hyprland-preview-share-picker). fedora-first-party.sh is version-pinned
# and stamp-guarded, so it only does work when a pin has moved.
#
# It also reconsiders the Hyprland core: `dnf upgrade` cannot move a machine off hyprland-git, since
# the stable package it wants is a different name it conflicts with. fedora-hyprland.sh swaps back to
# stable as soon as the COPR has a working build, so the fallback undoes itself unattended.

OMARCHY_PATH="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"
OMARCHY_INSTALL="${OMARCHY_INSTALL:-$OMARCHY_PATH/install}"

source "$OMARCHY_INSTALL/helpers/distro.sh"

if ! is_fedora; then
  exit 0
fi

# --user, because that is where the installer puts them. A plain `flatpak update` also reaches for the
# system installation, and refreshing its metadata needs polkit: the update then stops dead on a
# password prompt in the middle of the run - or hangs outright where no polkit agent is listening.
if command -v flatpak >/dev/null 2>&1 && [[ -n "$(flatpak list --app --user --columns=application 2>/dev/null)" ]]; then
  echo -e "\e[32m\nUpdate Flatpak apps\e[0m"
  flatpak update -y --user || echo "[WARNING] Flatpak update failed - continuing"
fi

if [[ -f "$OMARCHY_INSTALL/helpers/fedora-hyprland.sh" ]]; then
  echo -e "\e[32m\nCheck the Hyprland core package\e[0m"
  bash "$OMARCHY_INSTALL/helpers/fedora-hyprland.sh" || echo "[WARNING] Hyprland core check failed - continuing"
fi

if [[ -f "$OMARCHY_INSTALL/helpers/fedora-first-party.sh" ]]; then
  echo -e "\e[32m\nUpdate first-party tools\e[0m"
  bash "$OMARCHY_INSTALL/helpers/fedora-first-party.sh" || echo "[WARNING] First-party tool update failed - continuing"
fi
