#!/bin/bash

# omarchy:summary=Update everything dnf cannot reach: the Flatpak apps
# omarchy:requires-sudo=true

# On Arch, `yay -Sua` sweeps up everything outside the distro's repositories. This is the Fedora
# equivalent. Since quattro retired the source-built launcher stack (walker, elephant, and the cargo
# TUIs), the only thing left that a plain `dnf upgrade` can never move is Flatpak: Typora, LocalSend,
# Obsidian and Moonlight come from Flathub, and nothing else updates them.

OMARCHY_PATH="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"
OMARCHY_INSTALL="${OMARCHY_INSTALL:-$OMARCHY_PATH/install}"

source "$OMARCHY_INSTALL/helpers/distro.sh"

if ! is_fedora; then
  exit 0
fi

# --user, because that is where the installer puts them. A plain `flatpak update` also reaches for the
# system installation, and refreshing its metadata needs polkit: the update then stops dead on a
# password prompt in the middle of the run - or hangs outright where no polkit agent is listening.
if command -v flatpak >/dev/null 2>&1 && [[ -n "$(flatpak list --app --user --columns=application 2>/dev/null)" ]]; then
  echo -e "\e[32m\nUpdate Flatpak apps\e[0m"
  flatpak update -y --user || echo "[WARNING] Flatpak update failed - continuing"
fi
