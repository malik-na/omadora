show_install_ai_menu() {
  local ollama_pkg
  ollama_pkg=$(
    (omarchy-cmd-present nvidia-smi && echo ollama-cuda) ||
      (omarchy-cmd-present rocminfo && echo ollama-rocm) ||
      echo ollama
  )

  case $(menu "Install" $'󱚤  Claude Code\n󱚤  Cursor CLI\n󱚤  Gemini\n󱚤  OpenAI Codex\n󱚤  LM Studio\n󱚤  Ollama\n󱚤  Crush\n󱚤  opencode') in
  *Claude*) aur_install "Claude Code" "claude-code" ;;
  *Cursor*) aur_install "Cursor CLI" "cursor-cli" ;;
  *OpenAI*) aur_install "OpenAI Codex" "openai-codex-bin" ;;
  *Gemini*) aur_install "Gemini" "gemini-cli" ;;
  *Studio*) aur_install "LM Studio" "lmstudio" ;;
  *Ollama*) install "Ollama" "$ollama_pkg" ;;
  *Crush*) aur_install "Crush" "crush-bin" ;;
  *opencode*) aur_install "opencode" "opencode" ;;
  *) show_install_menu ;;
  esac
}

