#!/bin/bash

# omarchy:summary=Roll the root subvolume back to a snapshot (Apple Silicon)
# omarchy:group=system
# omarchy:requires-sudo=true
# omarchy:hidden=true

# limine-snapper-restore is Arch/Limine-only. This restores by swapping the live
# root subvolume for a writable copy of a chosen snapper snapshot.
#
# Layouts:
#   Arch Asahi Alarm often uses subvol=@
#   Fedora Asahi Remix uses subvol=root
# Named fstab/cmdline subvolumes cannot use snapper's default-subvol rollback.

set -euo pipefail

TOP=/run/omarchy-snapshot-restore

log() {
  printf '\033[32m==>\033[0m %s\n' "$*"
}

warn() {
  printf '\033[33mWarning:\033[0m %s\n' "$*" >&2
}

fail() {
  printf '\033[31mError:\033[0m %s\n' "$*" >&2
  exit 1
}

# Detect the live root subvolume name (@ or root).
detect_root_subvol() {
  local opts subvol
  opts=$(findmnt -no OPTIONS /)
  if [[ $opts =~ subvol=/([^,]+) ]]; then
    subvol=${BASH_REMATCH[1]}
    # findmnt sometimes reports subvol=/root without leading semantics
    printf '%s\n' "${subvol#/}"
    return 0
  fi
  if [[ $opts =~ subvol=([^,/]+) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
    return 0
  fi
  return 1
}

snapshot_subvol_path() {
  printf '%s/.snapshots/%s/snapshot' "$ROOT_SUBVOL" "$1"
}

list_snapper_snapshots() {
  snapper -c root --csvout list 2>/dev/null |
    awk -F, '
      NR == 1 {
        for (i = 1; i <= NF; i++) {
          gsub(/^"|"$/, "", $i)
          col[$i] = i
        }
        next
      }
      {
        number = $col["number"]
        gsub(/^"|"$/, "", number)
        if (number == "" || number == "0") next
        date = col["date"] ? $col["date"] : ""
        description = col["description"] ? $col["description"] : ""
        gsub(/^"|"$/, "", date)
        gsub(/^"|"$/, "", description)
        printf "%s\t%s\t%s\n", number, date, description
      }'
}

choice_label() {
  local summary="$1" path="$2"
  printf '%s  --  %s' "$summary" "$(describe_subvolume "$path")"
}

describe_subvolume() {
  local path="$1" version="" candidate
  if [[ -f $TOP/$path/usr/share/omarchy/version ]]; then
    version=$(head -1 "$TOP/$path/usr/share/omarchy/version" 2>/dev/null || echo unknown)
  else
    for candidate in "$TOP/$path"/home/*/.local/share/omarchy/version; do
      [[ -f $candidate ]] || continue
      version=$(head -1 "$candidate" 2>/dev/null || echo unknown)
      break
    done
  fi
  if [[ -n $version ]]; then
    printf 'Omarchy %s is installed in it' "$version"
  else
    printf 'no Omarchy installed in it'
  fi
}

cleanup() {
  mountpoint -q "$TOP" && umount "$TOP" 2>/dev/null || true
  [[ -d $TOP ]] && rmdir "$TOP" 2>/dev/null || true
}

main() {
  (( EUID == 0 )) || fail "run as root"

  local root_source
  root_source=$(findmnt -no SOURCE / | sed 's/\[.*\]//')
  [[ $(findmnt -no FSTYPE /) == "btrfs" ]] || fail "/ is not btrfs; nothing to roll back to"

  ROOT_SUBVOL=$(detect_root_subvol) ||
    fail "could not detect the root btrfs subvolume name"
  case $ROOT_SUBVOL in
    @ | root) ;;
    *)
      fail "/ is mounted from subvol=$ROOT_SUBVOL; only @ and root are supported"
      ;;
  esac

  trap cleanup EXIT
  mkdir -p "$TOP"
  mount -o subvolid=5 "$root_source" "$TOP"

  local -a labels=() paths=()
  local number date description path baseline

  # Optional install baselines (Arch Asahi may leave @fresh/@factory; Fedora usually does not).
  for baseline in @fresh @factory; do
    [[ -d $TOP/$baseline ]] || continue
    labels+=("$(choice_label "$baseline  install baseline" "$baseline")")
    paths+=("$baseline")
  done

  while IFS=$'\t' read -r number date description; do
    path=$(snapshot_subvol_path "$number")
    [[ -d $TOP/$path ]] || continue
    labels+=("$(choice_label "snapshot $number  $date  ${description:-no description}" "$path")")
    paths+=("$path")
  done < <(list_snapper_snapshots)

  (( ${#paths[@]} )) || fail "no snapshots found to restore"

  local choice=""
  if command -v gum >/dev/null 2>&1; then
    choice=$(printf '%s\n' "${labels[@]}" | gum choose --header "Restore which snapshot?") || exit 1
  else
    local i
    for i in "${!labels[@]}"; do
      printf '%3d) %s\n' "$((i + 1))" "${labels[$i]}"
    done
    local picked
    read -rp "Restore which? [1-${#labels[@]}] " picked
    [[ $picked =~ ^[0-9]+$ ]] && (( picked >= 1 && picked <= ${#labels[@]} )) ||
      fail "not a choice"
    choice=${labels[$((picked - 1))]}
  fi

  local index=-1 i
  for i in "${!labels[@]}"; do
    [[ ${labels[$i]} == "$choice" ]] && index=$i && break
  done
  (( index >= 0 )) || fail "could not match that choice"

  local source_path=${paths[$index]}
  local stamp
  stamp=$(date +%s)
  local live=$ROOT_SUBVOL
  local new_name="${ROOT_SUBVOL}new"
  local old_name="${ROOT_SUBVOL}old-$stamp"

  echo
  log "Restoring ${labels[$index]}"
  log "  subvolume: $source_path"
  log "  contents:  $(describe_subvolume "$source_path")"
  log "The current root is kept as $old_name until you delete it."
  warn "/boot is outside the root snapshot: the kernel and initramfs stay as they are."
  warn "After rolling back across a kernel update, run: sudo dracut -f"
  echo
  local typed
  read -rp "Type 'restore' to continue: " typed
  [[ $typed == "restore" ]] || fail "not confirmed"

  # Avoid colliding with an existing temporary name.
  rm -rf "$TOP/$new_name" 2>/dev/null || true
  btrfs subvolume snapshot "$TOP/$source_path" "$TOP/$new_name" >/dev/null
  mv "$TOP/$live" "$TOP/$old_name"
  mv "$TOP/$new_name" "$TOP/$live"

  local running restored_kernels
  running=$(uname -r)
  restored_kernels=$(cd "$TOP/$live/usr/lib/modules" 2>/dev/null && echo * || echo "")
  if [[ -n $restored_kernels && " $restored_kernels " != *" $running "* ]]; then
    echo
    warn "The restored system has modules for: $restored_kernels"
    warn "The kernel currently on /boot is $running, which is not among them."
    warn "Reinstall/rebuild the kernel from the restored system, or expect missing drivers."
  fi

  echo
  log "Restored. Reboot to run from it."
  log "If it is not what you wanted, from a shell on the restored system:"
  log "  sudo mount -o subvolid=5 $root_source /mnt"
  log "  sudo mv /mnt/$live /mnt/${live}discard && sudo mv /mnt/$old_name /mnt/$live && sudo reboot"
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
