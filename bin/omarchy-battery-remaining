#!/bin/bash

# omarchy:summary=Returns the battery percentage remaining as an integer.

battery_device=$(omarchy-battery-device)
[[ -n $battery_device ]] || exit 0

upower -i "$battery_device" \
| awk -F: '/percentage/ {
    gsub(/[%[:space:]]/, "", $2);
    val=$2;
    printf("%d\n", (val+0.5))
    exit
}'
