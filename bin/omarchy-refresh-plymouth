#!/bin/bash

# omarchy:summary=Overwrite the Plymouth theme with Omarchy defaults and rebuild initramfs
# omarchy:requires-sudo=true

set -euo pipefail

OMARCHY_PATH="${OMARCHY_PATH:-${OMARCHY_PATH_DEFAULT:-$HOME/.local/share/omarchy}}"
theme_src="${OMARCHY_PATH}/default/plymouth"
theme_dst="/usr/share/plymouth/themes/omarchy"

sudo mkdir -p "$theme_dst"
sudo cp -RT "$theme_src" "$theme_dst"
sudo plymouth-set-default-theme omarchy

if [[ -f ${OMARCHY_PATH}/etc/plymouth/plymouthd.conf ]]; then
  sudo install -Dm644 "${OMARCHY_PATH}/etc/plymouth/plymouthd.conf" /etc/plymouth/plymouthd.conf
fi

failed=0
for kernel in /lib/modules/*; do
  [[ -d $kernel ]] || continue
  kver=$(basename "$kernel")
  if ! sudo dracut --force "/boot/initramfs-${kver}.img" "$kver"; then
    echo "[WARN] dracut failed for $kver" >&2
    failed=1
  fi
done

exit "$failed"
