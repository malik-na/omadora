#!/bin/bash

# omarchy:summary=Reinstall all default Omarchy packages
# omarchy:requires-sudo=true

set -e

# Ensure every package in the Fedora default set is installed. dnf skips anything already present,
# so this is safe to re-run; it repairs an install where packages were removed by hand.
mapfile -t packages < <(grep -vE '^\s*#|^\s*$' "$OMARCHY_PATH/install/omarchy-base.packages.fedora")
sudo dnf install -y --skip-unavailable "${packages[@]}"
