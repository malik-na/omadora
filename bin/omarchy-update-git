#!/bin/bash

# omarchy:summary=Pull the latest Omarchy git changes

set -e

echo -e "\e[32mUpdate Omarchy\e[0m"

omarchy-update-time

# Suppress Hyprland config errors while git updates default config files mid-pull
hyprctl keyword debug:suppress_errors true &>/dev/null || true

# Fetch only from the branch's configured remote (usually origin). Checkouts that
# also track omarchy-mac as `upstream` can carry same-named release tags at
# different SHAs; a plain `git fetch --tags` then refuses to move them
# ("would clobber existing tag") and aborts the update under set -e.
branch=$(git -C "$OMARCHY_PATH" rev-parse --abbrev-ref HEAD)
remote=$(git -C "$OMARCHY_PATH" config --get "branch.${branch}.remote" 2>/dev/null || true)
remote=${remote:-origin}

git -C "$OMARCHY_PATH" fetch "$remote" --prune
# --force updates colliding tags to match this remote's releases.
git -C "$OMARCHY_PATH" fetch "$remote" --tags --force
git -C "$OMARCHY_PATH" pull --autostash
git -C "$OMARCHY_PATH" --no-pager diff --check || git -C "$OMARCHY_PATH" reset --merge

hyprctl reload &>/dev/null || true

# Update version file from highest merged release tag.
# Using describe can pick an older local tag after merge-heavy histories.
latest_tag=$(git -C "$OMARCHY_PATH" tag --merged HEAD --list 'v*' | sed 's/^v//' | sort -V | tail -1)
current_version=$(cat "$OMARCHY_PATH/version" 2>/dev/null || true)
if [ -n "$latest_tag" ]; then
  # Keep a newer branch version if release tags are behind.
  if [ -z "$current_version" ] || [ "$(printf '%s\n%s\n' "$current_version" "$latest_tag" | sort -V | tail -1)" = "$latest_tag" ]; then
    echo "$latest_tag" > "$OMARCHY_PATH/version"
  fi
fi
