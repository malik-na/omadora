#!/bin/bash

# omarchy:summary=Run the full Omarchy update pipeline
# omarchy:requires-sudo=true

set -e

# Fedora 44 gate: refuse the whole update pipeline on an older release and print the upgrade
# instructions. Nothing is touched, so the machine stays on its working Omarchy 3.5.0.
# Omarchy never runs `dnf system-upgrade` for the user - it reboots the machine and can leave an
# Asahi install unbootable.
OMARCHY_INSTALL="${OMARCHY_INSTALL:-${OMARCHY_PATH:-$HOME/.local/share/omarchy}/install}"
if [[ -f "$OMARCHY_INSTALL/helpers/distro.sh" ]]; then
  source "$OMARCHY_INSTALL/helpers/distro.sh"
  if is_fedora && ! is_fedora_supported_version; then
    fedora_upgrade_instructions
    exit 1
  fi
fi

# Run the update inside a PTY so dnf keeps showing download progress
# while still logging the full session for later analysis.
if [[ -z $OMARCHY_UPDATE_LOGGED ]]; then
  if command -v script >/dev/null 2>&1; then
    script_command=$(printf '%q ' "$0" "$@")
    exec env OMARCHY_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/omarchy-update.log"
  else
    export OMARCHY_UPDATE_LOGGED=1
  fi
fi

# Ensure screensaver/sleep doesn't set in during updates
hyprctl dispatch tagwindow +noidle &>/dev/null || true

# Perform all update steps
omarchy-update-time
omarchy-update-keyring

# Save newest installed kernel package version before updates.
kernel_pkg=""
if rpm -q kernel-core >/dev/null 2>&1; then
  kernel_pkg="kernel-core"
elif rpm -q kernel-16k-core >/dev/null 2>&1; then
  kernel_pkg="kernel-16k-core"
fi

if [ -n "$kernel_pkg" ]; then
  rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n' "$kernel_pkg" 2>/dev/null | sort -V | tail -1 > /tmp/omarchy-kernel-before
else
  : > /tmp/omarchy-kernel-before
fi
omarchy-update-available-reset
omarchy-update-system-pkgs
omarchy-migrate
omarchy-update-manual-pkgs
omarchy-update-aur-pkgs
omarchy-update-orphan-pkgs
omarchy-hook post-update

omarchy-update-analyze-logs

omarchy-update-restart

# Re-enable screensaver/sleep after updates
hyprctl dispatch tagwindow -- -noidle &>/dev/null || true
