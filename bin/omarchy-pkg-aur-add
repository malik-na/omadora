#!/bin/bash

# omarchy:summary=Add the named packages to the system if they're missing. Returns false if it couldn't be done.
# omarchy:args=<packages...>

# There is no AUR on Fedora. Anything an upstream flow tries to install "from the AUR" either has a
# Fedora/COPR package under the same name - in which case the regular dnf path below handles it - or
# it does not exist here, and failing loudly beats pretending.
echo "AUR is unavailable on Fedora. Installing from the enabled dnf repositories instead."
exec omarchy-pkg-add "$@"
