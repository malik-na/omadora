#!/bin/bash

# omarchy:summary=Returns a list of all the available power profiles on the system.
# omarchy:args=[--active-state]

if [[ ${1:-} != "" && ${1:-} != "--active-state" ]]; then
  echo "Usage: omarchy-powerprofiles-list [--active-state]" >&2
  exit 1
fi

# power-profiles-daemon is not guaranteed to be reachable on every Fedora Asahi machine, so fall
# back to a single balanced profile. --active-state must still emit the active column the shell's
# power panel parses (profile<TAB>1|0), or no profile ever reads as active.
if ! command -v powerprofilesctl >/dev/null 2>&1; then
  if [[ ${1:-} == "--active-state" ]]; then
    printf 'balanced\t1\n'
  else
    printf 'balanced\n'
  fi
  exit 0
fi

powerprofilesctl list 2>/dev/null |
  awk -v with_state="${1:+1}" '/^\s*[* ]\s*[a-zA-Z0-9-]+:$/ {
    active = ($1 == "*") ? 1 : 0
    gsub(/^[*[:space:]]+|:$/, "")
    print $0 (with_state ? "\t" active : "")
  }' |
  tac
